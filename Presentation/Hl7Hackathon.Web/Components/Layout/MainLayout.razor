@inherits LayoutComponentBase
@inject IDialogService DialogService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">HL7 Hackathon – Telemedicine</MudText>
        <MudSpacer />
        <MudTooltip Text="FHIR server">
            <MudIconButton Icon="@Icons.Material.Filled.Dns" Color="Color.Inherit" OnClick="OpenFhirServerAsync" />
        </MudTooltip>
        <MudTooltip Text="Last FHIR exchange">
            <MudIconButton Icon="@Icons.Material.Filled.SwapVert" Color="Color.Inherit" OnClick="OpenFhirExchangeAsync" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.False" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Nothing is at stake in these two, so the built-in close button and Escape are enough.
    private static readonly DialogOptions _serverDialogOptions = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    // Wider, because the request and response bodies sit side by side.
    private static readonly DialogOptions _exchangeDialogOptions = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true
    };

    private Task OpenFhirServerAsync() =>
        DialogService.ShowAsync<FhirServerDialog>("FHIR server", _serverDialogOptions);

    private Task OpenFhirExchangeAsync() =>
        DialogService.ShowAsync<FhirExchangeDialog>("Last FHIR exchange", _exchangeDialogOptions);
}
