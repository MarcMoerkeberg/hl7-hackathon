@page "/"
@using Hl7Hackathon.Core.Models.Domain
@inject IFhirServerFactory FhirServerFactory
@inject IPatientFactory PatientFactory

<PageTitle>Home</PageTitle>

<MudStack Spacing="4">
    <MudPaper Class="pa-4">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">FHIR server</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_checkingServer" OnClick="CheckServerAsync">
                Check connection
            </MudButton>
        </MudStack>

        @if (_checkingServer)
        {
            <MudProgressLinear Indeterminate Class="my-4" />
        }
        else if (_serverResult is { IsFailure: true })
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Style="white-space: pre-line">@_serverResult.Error.Message</MudAlert>
        }
        else if (_serverResult is { IsSuccess: true } && _serverResult.Value is { } server)
        {
            <MudSimpleTable Dense Class="mt-4">
                <tbody>
                    <tr><td>Name</td><td>@server.Name</td></tr>
                    <tr><td>Base URL</td><td>@server.BaseUrl</td></tr>
                    <tr><td>Software</td><td>@server.SoftwareName @server.SoftwareVersion</td></tr>
                    <tr><td>FHIR version</td><td>@server.FhirVersion</td></tr>
                    <tr><td>Resource types</td><td>@server.SupportedResourceTypes.Count</td></tr>
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6">Patients (local database)</MudText>

        @if (_patientsResult is { IsFailure: true })
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_patientsResult.Error.Message</MudAlert>
        }
        else
        {
            <MudTable Items="_patientsResult?.Value" Loading="_patientsResult is null" Dense Hover Class="mt-4">
                <HeaderContent>
                    <MudTh>CPR</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Gender</MudTh>
                    <MudTh>Birth date</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Cpr</MudTd>
                    <MudTd>@context.GivenName @context.FamilyName</MudTd>
                    <MudTd>@context.Gender</MudTd>
                    <MudTd>@context.BirthDate</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No patients. Set SeedDatabase to true to seed fictitious patients.</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudStack>

@code {
    private Result<FhirServerInfoModel>? _serverResult;
    private Result<IReadOnlyList<PatientModel>>? _patientsResult;
    private bool _checkingServer;

    protected override async Task OnInitializedAsync()
    {
        _patientsResult = await PatientFactory.GetPatientsAsync();
    }

    private async Task CheckServerAsync()
    {
        _checkingServer = true;
        _serverResult = await FhirServerFactory.GetFhirServerInfoAsync();
        _checkingServer = false;
    }
}
